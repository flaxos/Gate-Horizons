#:import utils kivy.utils

<TopBar>:
    size_hint_y: None
    height: dp(48)
    canvas.before:
        Color:
            rgba: 0.05, 0.08, 0.15, 1
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: 0.15, 0.6, 0.8, 0.6
        Line:
            points: [self.x, self.y, self.right, self.y]
            width: 1

<BottomBar>:
    size_hint_y: None
    height: dp(56)
    canvas.before:
        Color:
            rgba: 0.05, 0.08, 0.15, 1
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: 0.15, 0.6, 0.8, 0.6
        Line:
            points: [self.x, self.top, self.right, self.top]
            width: 1

<NavButton>:
    size_hint: None, None
    size: dp(80), dp(44)
    background_color: 0, 0, 0, 0
    color: 0.7, 0.85, 1, 1
    font_size: sp(13)
    canvas.before:
        Color:
            rgba: (0.1, 0.3, 0.5, 0.8) if self.state == 'down' else (0.08, 0.15, 0.25, 0.6)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(4)]

<EndTurnButton>:
    size_hint: None, None
    size: dp(110), dp(44)
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    font_size: sp(14)
    bold: True
    text: "END TURN"
    canvas.before:
        Color:
            rgba: (0.2, 0.6, 0.3, 1) if self.state == 'normal' else (0.15, 0.45, 0.22, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(6)]

<SidePanel>:
    size_hint_x: None
    width: dp(280)
    canvas.before:
        Color:
            rgba: 0.04, 0.06, 0.12, 0.95
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: 0.15, 0.6, 0.8, 0.4
        Line:
            points: [self.x, self.y, self.x, self.top]
            width: 1

<PanelLabel>:
    size_hint_y: None
    height: dp(28)
    font_size: sp(13)
    color: 0.7, 0.85, 1, 1
    text_size: self.size
    halign: 'left'
    valign: 'middle'
    padding: [dp(8), 0]

<PanelHeader>:
    size_hint_y: None
    height: dp(36)
    font_size: sp(15)
    bold: True
    color: 0.3, 0.85, 1, 1
    text_size: self.size
    halign: 'left'
    valign: 'middle'
    padding: [dp(8), 0]

<ActionButton>:
    size_hint_y: None
    height: dp(40)
    background_color: 0, 0, 0, 0
    color: 0.85, 0.95, 1, 1
    font_size: sp(13)
    canvas.before:
        Color:
            rgba: (0.12, 0.25, 0.4, 0.8) if self.state == 'normal' else (0.15, 0.35, 0.55, 0.9)
        RoundedRectangle:
            pos: self.x + dp(4), self.y + dp(2)
            size: self.width - dp(8), self.height - dp(4)
            radius: [dp(4)]

<ResourceLabel>:
    size_hint: None, None
    size: dp(100), dp(40)
    font_size: sp(12)
    color: 0.8, 0.9, 1, 1
    text_size: self.size
    halign: 'center'
    valign: 'middle'
